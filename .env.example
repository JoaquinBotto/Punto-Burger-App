# ==============================================================================
# Punto Burger App - Variables de Entorno de Ejemplo (.env.example)
# ==============================================================================
# Copiar este archivo a .env.local para desarrollo local:
#   cp .env.example .env.local
#
# REGLAS DE SEGURIDAD ESTRICTAS:
# - Ninguna credencial real debe comitearse en Git.
# - DATABASE_URL y DATABASE_MIGRATION_URL son EXCLUSIVAMENTE server-side.
# - SUPABASE_SERVICE_ROLE_KEY es para uso administrativo del backend; NUNCA exponer al navegador.
# - SESSION_SECRET y ACCESS_CODE_SECRET residen EXCLUSIVAMENTE en el servidor.
# ==============================================================================

# Entorno de Ejecución
NODE_ENV=development
APP_URL=http://localhost:3000

# Base de Datos PostgreSQL (Supabase / DonWeb Cloud Server)
# DATABASE_URL: Conexión de runtime (Transaction Pooler en Supabase / puerto 6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/puntoburger
# DATABASE_MIGRATION_URL: Conexión directa para Drizzle Kit migrations (Session / puerto 5432)
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/puntoburger

# Supabase Auth & Servicios
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-placeholder
# LLAVE PRIVILEGIADA SERVER-SIDE (NUNCA EXPONER AL CLIENTE)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Sesiones Criptográficas de Mesa (Mínimo 32 caracteres)
SESSION_SECRET=change-me-to-a-secure-random-secret-at-least-32-chars

# Códigos Temporales Rotativos de Local (HMAC Determinístico, Mínimo 32 caracteres)
# IMPORTANTE: No reutilizar SESSION_SECRET para aislamiento criptográfico
ACCESS_CODE_SECRET=change-me-to-a-secure-random-access-code-secret-32-chars
