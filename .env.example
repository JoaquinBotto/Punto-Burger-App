# ==============================================================================
# Punto Burger App - Variables de Entorno de Ejemplo (.env.example)
# ==============================================================================
# Copiar este archivo a .env.local para desarrollo local:
#   cp .env.example .env.local
#
# REGLAS DE SEGURIDAD ESTRICTAS (SERVER-ONLY):
# - Ninguna credencial real debe comitearse en Git.
# - DATABASE_URL y DATABASE_MIGRATION_URL son EXCLUSIVAMENTE server-side.
# - SUPABASE_SECRET_KEY es de uso administrativo exclusivo en backend; NUNCA exponer al navegador ni imprimir en logs.
# - SESSION_SECRET y ACCESS_CODE_SECRET residen EXCLUSIVAMENTE en el servidor.
# ==============================================================================

# Entorno de Ejecución
NODE_ENV=development
APP_URL=http://localhost:3000

# Base de Datos PostgreSQL (Supabase / DonWeb Cloud Server)
# En DonWeb Cloud Server (backend persistente con soporte IPv6):
#   - Copiar ambas cadenas desde: Supabase Dashboard → Connect → Direct connection (Puerto 5432).
#   - Tanto DATABASE_URL como DATABASE_MIGRATION_URL se conectan directamente en puerto 5432.
#   - Fallback: Si la red en algún entorno fuese IPv4-only sin IPv6, utilizar Session Pooler (:5432).
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Supabase Auth & Servicios (API Keys Modernas de Supabase)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# LLAVE SECRETA ADMINISTRATIVA (SERVER-ONLY - NUNCA EXPONER AL CLIENTE)
SUPABASE_SECRET_KEY=

# Sesiones Criptográficas de Mesa (Mínimo 32 caracteres)
SESSION_SECRET=

# Códigos Temporales Rotativos de Local (HMAC Determinístico, Mínimo 32 caracteres)
# IMPORTANTE: No reutilizar SESSION_SECRET para aislamiento criptográfico
ACCESS_CODE_SECRET=
